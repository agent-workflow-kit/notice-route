{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "notice-route/hooks/post-fail.json",
  "title": "post-fail hook payload (stdin)",
  "description": "Fired after a destination's failure was surfaced (at most once per code and destination per UTC day, rate_capped once per destination per UTC hour). Carries no title, message, link or payload text. The router also routes this payload through its own rules as source notice-route.",
  "type": "object",
  "properties": {
    "tool": {
      "const": "notice-route"
    },
    "hook": {
      "const": "post-fail"
    },
    "object_type": {
      "const": "destination"
    },
    "object_id": {
      "$ref": "../defs.json#/$defs/destination_name"
    },
    "event_id": {
      "type": "integer",
      "minimum": 1,
      "description": "The id of the failing deliveries row."
    },
    "labels": {
      "type": "array",
      "items": {
        "$ref": "../defs.json#/$defs/label"
      },
      "x-untrusted": true,
      "maxItems": 96
    },
    "code": {
      "$ref": "../defs.json#/$defs/notifier_code"
    },
    "outcome": {
      "enum": [
        "failed",
        "unknown",
        "deferred",
        "dropped",
        "expired"
      ]
    },
    "attempts": {
      "type": "integer",
      "minimum": 0
    },
    "source": {
      "$ref": "../defs.json#/$defs/source_name",
      "x-untrusted": true
    },
    "level": {
      "$ref": "../defs.json#/$defs/level"
    },
    "kind": {
      "$ref": "../defs.json#/$defs/destination_kind"
    }
  },
  "additionalProperties": false,
  "required": [
    "tool",
    "hook",
    "object_type",
    "object_id",
    "event_id",
    "labels",
    "code",
    "outcome",
    "attempts",
    "source",
    "level",
    "kind"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "deferred"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "code": {
            "const": "rate_capped"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "dropped"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "code": {
            "const": "overflow"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "expired"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "code": {
            "const": "expired"
          }
        }
      }
    }
  ]
}
