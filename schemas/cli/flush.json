{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "notice-route/cli/flush.json",
  "title": "flush --json output",
  "description": "Exit 0 (ok), 12 (partial: a call ended failed or unknown) and 22 (no_op: every destination nothing_due or disabled, or no config, or enabled false; the destinations list is empty for the last two). With --dry-run the due_* counts are filled and the result counts and digests are 0. A destination in state already_running, disabled or env_missing was skipped and has every count 0.",
  "type": "object",
  "properties": {
    "outcome": {
      "enum": [
        "ok",
        "partial",
        "no_op"
      ]
    },
    "dry_run": {
      "type": "boolean"
    },
    "destinations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "$ref": "../defs.json#/$defs/destination_name"
          },
          "state": {
            "enum": [
              "done",
              "already_running",
              "nothing_due",
              "quiet",
              "disabled",
              "env_missing"
            ]
          },
          "due_single": {
            "type": "integer",
            "minimum": 0
          },
          "due_held": {
            "type": "integer",
            "minimum": 0
          },
          "sent": {
            "type": "integer",
            "minimum": 0
          },
          "queued_retry": {
            "type": "integer",
            "minimum": 0
          },
          "failed": {
            "type": "integer",
            "minimum": 0
          },
          "unknown": {
            "type": "integer",
            "minimum": 0
          },
          "dropped": {
            "type": "integer",
            "minimum": 0
          },
          "expired": {
            "type": "integer",
            "minimum": 0
          },
          "digests": {
            "type": "integer",
            "minimum": 0,
            "description": "Digest notifications built from held rows."
          }
        },
        "additionalProperties": false,
        "required": [
          "name",
          "state",
          "due_single",
          "due_held",
          "sent",
          "queued_retry",
          "failed",
          "unknown",
          "dropped",
          "expired",
          "digests"
        ]
      }
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "outcome",
    "dry_run",
    "destinations",
    "duration_ms"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "partial"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "destinations": {
            "contains": {
              "anyOf": [
                {
                  "properties": {
                    "failed": {
                      "minimum": 1
                    }
                  },
                  "required": [
                    "failed"
                  ]
                },
                {
                  "properties": {
                    "unknown": {
                      "minimum": 1
                    }
                  },
                  "required": [
                    "unknown"
                  ]
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "enum": [
              "ok",
              "no_op"
            ]
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "destinations": {
            "not": {
              "contains": {
                "anyOf": [
                  {
                    "properties": {
                      "failed": {
                        "minimum": 1
                      }
                    },
                    "required": [
                      "failed"
                    ]
                  },
                  {
                    "properties": {
                      "unknown": {
                        "minimum": 1
                      }
                    },
                    "required": [
                      "unknown"
                    ]
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "no_op"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "destinations": {
            "items": {
              "properties": {
                "state": {
                  "enum": [
                    "nothing_due",
                    "disabled"
                  ]
                },
                "sent": {
                  "const": 0
                },
                "queued_retry": {
                  "const": 0
                },
                "failed": {
                  "const": 0
                },
                "unknown": {
                  "const": 0
                },
                "dropped": {
                  "const": 0
                },
                "expired": {
                  "const": 0
                },
                "digests": {
                  "const": 0
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "dry_run": {
            "const": true
          }
        },
        "required": [
          "dry_run"
        ]
      },
      "then": {
        "properties": {
          "destinations": {
            "items": {
              "properties": {
                "sent": {
                  "const": 0
                },
                "queued_retry": {
                  "const": 0
                },
                "failed": {
                  "const": 0
                },
                "unknown": {
                  "const": 0
                },
                "dropped": {
                  "const": 0
                },
                "expired": {
                  "const": 0
                },
                "digests": {
                  "const": 0
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "destinations": {
            "contains": {
              "properties": {
                "state": {
                  "enum": [
                    "already_running",
                    "disabled",
                    "env_missing"
                  ]
                }
              },
              "required": [
                "state"
              ]
            }
          }
        },
        "required": [
          "destinations"
        ]
      },
      "then": {
        "properties": {
          "destinations": {
            "items": {
              "if": {
                "properties": {
                  "state": {
                    "enum": [
                      "already_running",
                      "disabled",
                      "env_missing"
                    ]
                  }
                },
                "required": [
                  "state"
                ]
              },
              "then": {
                "properties": {
                  "due_single": {
                    "const": 0
                  },
                  "due_held": {
                    "const": 0
                  },
                  "sent": {
                    "const": 0
                  },
                  "queued_retry": {
                    "const": 0
                  },
                  "failed": {
                    "const": 0
                  },
                  "unknown": {
                    "const": 0
                  },
                  "dropped": {
                    "const": 0
                  },
                  "expired": {
                    "const": 0
                  },
                  "digests": {
                    "const": 0
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
