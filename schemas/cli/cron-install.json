{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "notice-route/cli/cron-install.json",
  "title": "cron install --json output",
  "type": "object",
  "properties": {
    "action": {
      "enum": [
        "installed",
        "updated",
        "unchanged"
      ]
    },
    "block": {
      "type": "string",
      "description": "The managed block as it is in the crontab after the command, or would be with --dry-run."
    },
    "dry_run": {
      "type": "boolean"
    },
    "env_file": {
      "type": [
        "string",
        "null"
      ],
      "description": "Absolute path from cron.env_file; null when unset."
    }
  },
  "additionalProperties": false,
  "required": [
    "action",
    "block",
    "dry_run",
    "env_file"
  ]
}
