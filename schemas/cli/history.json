{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "notice-route/cli/history.json",
  "title": "history --json output",
  "description": "A list of history rows, newest first, at most 1000.",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "ts": {
        "$ref": "../defs.json#/$defs/ts"
      },
      "source": {
        "$ref": "../defs.json#/$defs/source_name",
        "x-untrusted": true
      },
      "hook": {
        "oneOf": [
          {
            "$ref": "../defs.json#/$defs/hook_name",
            "x-untrusted": true
          },
          {
            "type": "null"
          }
        ]
      },
      "rule": {
        "oneOf": [
          {
            "$ref": "../defs.json#/$defs/rule_name"
          },
          {
            "type": "null"
          }
        ]
      },
      "destination": {
        "oneOf": [
          {
            "$ref": "../defs.json#/$defs/destination_name"
          },
          {
            "type": "null"
          }
        ]
      },
      "level": {
        "$ref": "../defs.json#/$defs/level"
      },
      "outcome": {
        "$ref": "../defs.json#/$defs/history_outcome"
      },
      "reason": {
        "oneOf": [
          {
            "$ref": "../defs.json#/$defs/destination_reason"
          },
          {
            "type": "null"
          }
        ]
      },
      "code": {
        "oneOf": [
          {
            "$ref": "../defs.json#/$defs/notifier_code"
          },
          {
            "type": "null"
          }
        ]
      },
      "attempts": {
        "type": "integer",
        "minimum": 0
      },
      "event_id": {
        "oneOf": [
          {
            "$ref": "../defs.json#/$defs/event_id",
            "x-untrusted": true
          },
          {
            "type": "null"
          }
        ]
      },
      "dedupe": {
        "oneOf": [
          {
            "$ref": "../defs.json#/$defs/sha256_64"
          },
          {
            "type": "null"
          }
        ]
      },
      "labels": {
        "type": "array",
        "items": {
          "$ref": "../defs.json#/$defs/label"
        },
        "x-untrusted": true,
        "maxItems": 64
      },
      "surfaced": {
        "type": "boolean"
      },
      "deliver_after": {
        "oneOf": [
          {
            "$ref": "../defs.json#/$defs/epoch_seconds"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "additionalProperties": false,
    "required": [
      "ts",
      "source",
      "hook",
      "rule",
      "destination",
      "level",
      "outcome",
      "reason",
      "code",
      "attempts",
      "event_id",
      "dedupe",
      "labels",
      "surfaced",
      "deliver_after"
    ],
    "description": "One history row. Never contains title or message text."
  },
  "maxItems": 1000
}
