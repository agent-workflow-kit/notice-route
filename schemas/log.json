          "dropped": {
            "type": "null"
          },
          "expired": {
            "type": "null"
          },
          "mode": {
            "type": "null"
          },
          "result": {
            "type": "null"
          },
          "override": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record": {
            "const": "flush"
          }
        },
        "required": [
          "record"
        ]
      },
      "then": {
        "properties": {
          "source": {
            "type": "null"
          },
          "hook": {
            "type": "null"
          },
          "rule": {
            "type": "null"
          },
          "destination": {
            "type": "null"
          },
          "level": {
            "type": "null"
          },
          "outcome": {
            "type": "null"
          },
          "reason": {
            "type": "null"
          },
          "code": {
            "type": "null"
          },
          "attempts": {
            "type": "null"
          },
          "title_sha256": {
            "type": "null"
          },
          "message_sha256": {
            "type": "null"
          },
          "event_id": {
            "type": "null"
          },
          "dedupe_key_sha256": {
            "type": "null"
          },
          "due": {
            "type": "integer"
          },
          "sent": {
            "type": "integer"
          },
          "queued_retry": {
            "type": "integer"
          },
          "failed": {
            "type": "integer"
          },
          "unknown": {
            "type": "integer"
          },
          "dropped": {
            "type": "integer"
          },
          "expired": {
            "type": "integer"
          },
          "mode": {
            "type": "null"
          },
          "result": {
            "type": "null"
          },
          "override": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record": {
            "const": "hook"
          }
        },
        "required": [
          "record"
        ]
      },
      "then": {
        "properties": {
          "source": {
            "type": "null"
          },
          "rule": {
            "type": "null"
          },
          "level": {
            "type": "null"
          },
          "outcome": {
            "type": "null"
