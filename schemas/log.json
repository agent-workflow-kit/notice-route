{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "notice-route/log.json",
  "title": "notice-route log.jsonl record",
  "description": "One line per destination outcome (record delivery) and per flush summary (record flush). Never holds title text, message text, links or credentials; titles and messages appear only as the first 16 hex of the SHA-256 of the rendered UTF-8 text. A drop rule and no_rule write a delivery record with destination null and reason rule_drop or no_rule. A flush record carries totals across the destinations it handled, with destination null. Rotates at 10 MiB, keeping three rotated files (log.1 to log.3). It is a record of recent activity, not an audit trail. A problem with the log warns on stderr and never changes a result. ts is UTC with milliseconds. actor and decision_id are the --actor and --decision-id of the call.",
  "type": "object",
  "properties": {
    "ts": {
      "$ref": "defs.json#/$defs/ts"
    },
    "tool": {
      "const": "notice-route"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "record": {
      "enum": [
        "delivery",
        "flush"
      ]
    },
    "source": {
      "oneOf": [
        {
          "$ref": "defs.json#/$defs/source_name",
          "x-untrusted": true
        },
        {
          "type": "null"
        }
      ]
    },
    "hook": {
      "oneOf": [
        {
          "$ref": "defs.json#/$defs/hook_name",
          "x-untrusted": true
        },
        {
          "type": "null"
        }
      ]
    },
    "rule": {
      "oneOf": [
        {
          "$ref": "defs.json#/$defs/rule_name"
        },
        {
          "type": "null"
        }
      ]
    },
    "destination": {
      "oneOf": [
        {
          "$ref": "defs.json#/$defs/destination_name"
        },
        {
          "type": "null"
        }
      ]
    },
    "level": {
      "oneOf": [
        {
          "$ref": "defs.json#/$defs/level"
        },
        {
          "type": "null"
        }
      ]
    },
    "outcome": {
      "oneOf": [
        {
          "$ref": "defs.json#/$defs/log_outcome"
        },
        {
          "type": "null"
        }
      ]
    },
    "reason": {
      "oneOf": [
        {
          "$ref": "defs.json#/$defs/destination_reason"
        },
        {
          "type": "null"
        }
      ]
    },
    "code": {
      "oneOf": [
        {
          "$ref": "defs.json#/$defs/notifier_code"
        },
        {
          "type": "null"
        }
      ]
    },
    "attempts": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "title_sha256": {
      "oneOf": [
        {
          "$ref": "defs.json#/$defs/sha256_16"
        },
        {
          "type": "null"
        }
      ]
    },
    "message_sha256": {
      "oneOf": [
        {
          "$ref": "defs.json#/$defs/sha256_16"
        },
        {
          "type": "null"
        }
      ]
    },
    "event_id": {
      "oneOf": [
        {
          "$ref": "defs.json#/$defs/event_id",
          "x-untrusted": true
        },
        {
          "type": "null"
        }
      ]
    },
    "dedupe_key_sha256": {
      "oneOf": [
        {
          "$ref": "defs.json#/$defs/sha256_16"
        },
        {
          "type": "null"
        }
      ]
    },
    "actor": {
      "$ref": "defs.json#/$defs/actor"
    },
    "decision_id": {
      "oneOf": [
        {
          "$ref": "defs.json#/$defs/decision_id"
        },
        {
          "type": "null"
        }
      ]
    },
    "due": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "sent": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "queued_retry": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "failed": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "unknown": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "dropped": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "expired": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "ts",
    "tool",
    "version",
    "record",
    "source",
    "hook",
    "rule",
    "destination",
    "level",
    "outcome",
    "reason",
    "code",
    "attempts",
    "title_sha256",
    "message_sha256",
    "event_id",
    "dedupe_key_sha256",
    "actor",
    "decision_id",
    "due",
    "sent",
    "queued_retry",
    "failed",
    "unknown",
    "dropped",
    "expired",
    "duration_ms"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "record": {
            "const": "delivery"
          }
        },
        "required": [
          "record"
        ]
      },
      "then": {
        "required": [
          "source",
          "outcome",
          "attempts"
        ],
        "properties": {
          "source": {
            "$ref": "defs.json#/$defs/source_name"
          },
          "outcome": {
            "$ref": "defs.json#/$defs/log_outcome"
          },
          "attempts": {
            "type": "integer"
          },
          "due": {
            "type": "null"
          },
          "sent": {
            "type": "null"
          },
          "queued_retry": {
            "type": "null"
          },
          "failed": {
            "type": "null"
          },
          "unknown": {
            "type": "null"
          },
          "dropped": {
            "type": "null"
          },
          "expired": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "source": {
            "type": "null"
          },
          "hook": {
            "type": "null"
          },
          "rule": {
            "type": "null"
          },
          "destination": {
            "type": "null"
          },
          "level": {
            "type": "null"
          },
          "outcome": {
            "type": "null"
          },
          "reason": {
            "type": "null"
          },
          "code": {
            "type": "null"
          },
          "attempts": {
            "type": "null"
          },
          "title_sha256": {
            "type": "null"
          },
          "message_sha256": {
            "type": "null"
          },
          "event_id": {
            "type": "null"
          },
          "dedupe_key_sha256": {
            "type": "null"
          },
          "due": {
            "type": "integer"
          },
          "sent": {
            "type": "integer"
          },
          "queued_retry": {
            "type": "integer"
          },
          "failed": {
            "type": "integer"
          },
          "unknown": {
            "type": "integer"
          },
          "dropped": {
            "type": "integer"
          },
          "expired": {
            "type": "integer"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record": {
            "const": "delivery"
          },
          "reason": {
            "not": {
              "enum": [
                "rule_drop",
                "no_rule"
              ]
            }
          }
        },
        "required": [
          "record"
        ]
      },
      "then": {
        "properties": {
          "destination": {
            "$ref": "defs.json#/$defs/destination_name"
          },
          "level": {
            "$ref": "defs.json#/$defs/level"
          }
        }
      }
    }
  ]
}
