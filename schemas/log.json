{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "notice-route/log.json",
  "title": "notice-route log.jsonl record",
  "description": "One line per destination outcome (record delivery), per flush summary (record flush), per post-fail hook run (record hook: destination, hook post-fail, mode sync or async, and a fixed-word result; an async hook is logged only as started or spawn_failed, since its end is not observed; gave_up marks the end of a synchronous hook's retries) and per change of a destination override (record override: destination and override disabled or cleared; every other field null). Never holds title text, message text, links or credentials; titles and messages appear only as the first 16 hex characters of the SHA-256 of the rendered UTF-8 title and message of the row (for a digest's rows, each row's own text); the dedupe digest as its first 16 characters (dedupe_key_sha256). A drop rule and no_rule write a delivery record with destination null and reason rule_drop or no_rule. A flush record carries totals across the destinations it handled, with destination null. Rotates at 10 MiB, keeping three rotated files (log.1 to log.3). It is a record of recent activity, not an audit trail. A problem with the log warns on stderr and never changes a result. ts is UTC with milliseconds. actor and decision_id are the --actor and --decision-id of the call.",
  "type": "object",
  "properties": {
    "ts": {
      "$ref": "defs.json#/$defs/ts"
    },
    "tool": {
      "const": "notice-route"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "record": {
      "enum": [
        "delivery",
        "flush",
        "hook",
        "override"
      ]
    },
    "source": {
      "oneOf": [
        {
          "$ref": "defs.json#/$defs/source_name",
          "x-untrusted": true
        },
        {
          "type": "null"
        }
      ]
    },
    "hook": {
      "oneOf": [
        {
          "$ref": "defs.json#/$defs/hook_name",
          "x-untrusted": true
        },
        {
          "type": "null"
        }
      ]
    },
    "rule": {
      "oneOf": [
        {
          "$ref": "defs.json#/$defs/rule_name"
        },
        {
          "type": "null"
        }
      ]
    },
    "destination": {
      "oneOf": [
        {
          "$ref": "defs.json#/$defs/destination_name"
        },
        {
          "type": "null"
        }
      ]
    },
    "level": {
      "oneOf": [
        {
          "$ref": "defs.json#/$defs/level"
        },
        {
          "type": "null"
        }
      ]
    },
    "outcome": {
      "oneOf": [
        {
          "$ref": "defs.json#/$defs/log_outcome"
        },
        {
          "type": "null"
        }
      ]
    },
    "reason": {
      "oneOf": [
        {
          "$ref": "defs.json#/$defs/destination_reason"
        },
        {
          "type": "null"
        }
      ]
    },
    "code": {
      "oneOf": [
        {
          "$ref": "defs.json#/$defs/notifier_code"
        },
        {
          "type": "null"
        }
      ]
    },
    "attempts": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "title_sha256": {
      "oneOf": [
        {
          "$ref": "defs.json#/$defs/sha256_16"
        },
        {
          "type": "null"
        }
      ]
    },
    "message_sha256": {
      "oneOf": [
        {
          "$ref": "defs.json#/$defs/sha256_16"
        },
        {
          "type": "null"
        }
      ]
    },
    "event_id": {
      "oneOf": [
        {
          "$ref": "defs.json#/$defs/event_id",
          "x-untrusted": true
        },
        {
          "type": "null"
        }
      ]
    },
    "dedupe_key_sha256": {
      "oneOf": [
        {
          "$ref": "defs.json#/$defs/sha256_16"
        },
        {
          "type": "null"
        }
      ]
    },
    "actor": {
      "$ref": "defs.json#/$defs/actor"
    },
    "decision_id": {
      "oneOf": [
        {
          "$ref": "defs.json#/$defs/decision_id"
        },
        {
          "type": "null"
        }
      ]
    },
    "due": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "description": "A flush record: the number of due rows (due_single plus due_held)."
    },
    "sent": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "queued_retry": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "failed": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "unknown": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "dropped": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "expired": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "mode": {
      "oneOf": [
        {
          "enum": [
            "sync",
            "async"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "result": {
      "oneOf": [
        {
          "enum": [
            "ok",
            "nonzero_exit",
            "signaled",
            "timeout",
            "overflow",
            "spawn_failed",
            "lost",
            "started",
            "gave_up"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "override": {
      "oneOf": [
        {
          "enum": [
            "disabled",
            "cleared"
          ]
        },
        {
          "type": "null"
        }
      ],
      "description": "An override record: the new state of the destination's override (disabled: set; cleared: deleted). Required on an override record; null on every other record, and absent in lines written before this field existed (1.0), which consumers accept."
    }
  },
  "additionalProperties": false,
  "required": [
    "ts",
    "tool",
    "version",
    "record",
    "source",
    "hook",
    "rule",
    "destination",
    "level",
    "outcome",
    "reason",
    "code",
    "attempts",
    "title_sha256",
    "message_sha256",
    "event_id",
    "dedupe_key_sha256",
    "actor",
    "decision_id",
    "due",
    "sent",
    "queued_retry",
    "failed",
    "unknown",
    "dropped",
    "expired",
    "duration_ms",
    "mode",
    "result"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "record": {
            "const": "delivery"
          }
        },
        "required": [
          "record"
        ]
      },
      "then": {
        "required": [
          "source",
          "outcome",
          "attempts"
        ],
        "properties": {
          "source": {
            "$ref": "defs.json#/$defs/source_name"
